# Copie este arquivo para `.env.local` e preencha os valores sem commitar segredos.

# Frontend
VITE_APP_TITLE="Criativa Field Ops"
VITE_API_BASE_URL="/api"
VITE_DEFAULT_INDUSTRIES="Veneza,Idealpan,Maricota,VidaVeg"

# Backend / Serverless
# Configure estes valores no ambiente do deploy ou em um arquivo separado do backend.
APP_SESSION_SECRET=""
BACKEND_GOOGLE_SHEETS_ID=""
# Impede que filtros da planilha sejam aceitos como uma base completa de lojas.
BACKEND_MIN_STORE_COUNT="100"
# Provedor operacional. Mantenha `make` ate concluir a homologacao Google.
BACKEND_SYNC_PROVIDER="make"
# Endpoint e segredo do ingresso Google. A flag acima controla o uso.
BACKEND_GOOGLE_SYNC_URL=""
BACKEND_GOOGLE_SYNC_TOKEN=""
# Teto de 1 a 20 fotos por tarefa Google.
BACKEND_GOOGLE_PHOTO_BATCH_SIZE="20"
BACKEND_MAKE_WEBHOOK_URL=""
# Webhook exclusivo do cenario v2. Nunca reutilize aqui o webhook legado.
BACKEND_MAKE_WEBHOOK_V2_URL=""
# Use `legacy` ate o cenario Make v2 estar configurado e validado no Drive e na planilha.
BACKEND_MAKE_SYNC_MODE="legacy"
# Ative somente depois de validar o cenario PHOTO_UPLOAD_BATCH na homologacao.
BACKEND_MAKE_PHOTO_BATCH_ENABLED="false"
# Teto de seguranca. Valores aceitos: 1 a 20.
BACKEND_MAKE_PHOTO_BATCH_SIZE="20"
# Timeout do backend aguardando a resposta do Make. Padrao: 45000 ms.
BACKEND_MAKE_REQUEST_TIMEOUT_MS="45000"
# Diagnostico protegido; configure flag e token somente em deploy-preview.
BACKEND_MAKE_TIMEOUT_PROBE_ENABLED="false"
BACKEND_MAKE_TIMEOUT_PROBE_TOKEN=""
BACKEND_GEMINI_API_KEY=""
BACKEND_SUPERVISOR_USERS=""
BACKEND_PROVISIONAL_SUPERVISORS=""
BACKEND_PROVISIONAL_USERS=""
BLOB_READ_WRITE_TOKEN=""
